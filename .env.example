# 复制为 .env 并填写。此文件含密钥，chmod 600，不要提交到 git。
# backup.sh 会 source 整个文件（变量导出给 restic/rclone）；notify.sh 只按行读取 TG_* / HOST_TAG。

# ---- restic ----
# 仓库地址。常见写法：
#   rclone:<remote>:<path>      经 rclone 到任意云盘（需要 RCLONE_CONFIG）
#   sftp:user@host:/path        SFTP
#   s3:https://s3.example.com/bucket   S3 兼容（另需 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY）
#   /mnt/backup/restic          本地/已挂载目录
RESTIC_REPOSITORY=rclone:myremote:backups/restic
# 仓库密码文件（chmod 600）。丢了密码 = 丢了全部备份，务必离线另存一份。
RESTIC_PASSWORD_FILE=/opt/docker-restic-backup/.restic-pass
# 可选：rclone 配置文件位置（用 rclone: 后端时）
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# 可选：pack 大小 MiB（云盘后端建议 32–64，减少小文件请求数）
RESTIC_PACK_SIZE=64

# ---- Telegram 通知（留空则 notify.sh 静默退出，脚本照常运行）----
TG_BOT_TOKEN=
TG_CHAT_ID=
# 可选：话题群（Forum）里的话题 ID，留空发到 General / 私聊
TG_THREAD_ID=

# ---- 可选：通知与 restic --host 使用的主机标识，缺省为 hostname -s ----
#HOST_TAG=myhost
